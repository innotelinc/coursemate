# CourseMate — environment contract
# Copy to .env or env.local (both are gitignored; env.local wins if both exist).
# Every variable below is optional; the defaults are chosen so `npm start` works
# on a fresh checkout.

# ── Server ────────────────────────────────────────────────────────────────────
# Bind address. Keep 127.0.0.1 unless you are capturing from a phone on your LAN
# (see capture/README.md — then use 0.0.0.0 and set COURSEMATE_TOKEN).
COURSEMATE_HOST=127.0.0.1
COURSEMATE_PORT=8790

# Shared secret. When set, every /api/* request must send
#   Authorization: Bearer <token>
# Required if you bind to 0.0.0.0.
COURSEMATE_TOKEN=

# Where the memory database and (optional) frame captures live.
COURSEMATE_DATA_DIR=./data

# Persist the raw screenshots the agent looked at. Off by default: the agent
# keeps only the text it read from them.
COURSEMATE_KEEP_FRAMES=0

# ── Model gateway (OpenAI-compatible) ─────────────────────────────────────────
# Any OpenAI-compatible endpoint. Defaults to the Innotel OmniRoute gateway;
# change it to http://127.0.0.1:20128/v1 to use a local install instead.
COURSEMATE_GATEWAY_URL=https://gateway.innotel.us/v1

# API key. If empty, the server reads the key from COURSEMATE_KEY_FILE.
COURSEMATE_API_KEY=
# OmniRoute writes its local key here by default (repo root).
COURSEMATE_KEY_FILE=../.omniroute-key

# Model used for reasoning, essays and reflection.
COURSEMATE_MODEL=auto/best-reasoning
# Model used for looking at the screen. Must accept image input.
# Verified against the Innotel gateway. Run `npm run live-check` to test yours.
COURSEMATE_VISION_MODEL=gemini/gemini-2.5-flash
# Model used for speech-to-text. A Whisper-style model is tried first on
# /audio/transcriptions; if your key cannot reach one, the same model is asked
# to transcribe the audio inline through a normal chat call.
COURSEMATE_STT_MODEL=gemini/gemini-2.5-flash

# Seconds to wait on a single gateway call before giving up.
COURSEMATE_TIMEOUT_MS=90000

# ── Personality ───────────────────────────────────────────────────────────
# A file you edit by hand. Re-read whenever it changes — no restart needed.
# The agent's voice, its banned phrases and its writing moves live here.
COURSEMATE_PERSONA_FILE=./persona.json

# ── Behaviour ─────────────────────────────────────────────────────────────────
# assist = decide and show the answer to you (default, human submits)
# auto   = same, but also POST the answer card to COURSEMATE_ACTION_WEBHOOK so
#          your own automation can act on it. Never submits anything itself.
COURSEMATE_MODE=assist

# Optional URL that receives every decision in auto mode.
COURSEMATE_ACTION_WEBHOOK=

# Below this confidence a decision is flagged needs_human instead of presented
# as an answer. 0..1
COURSEMATE_CONFIDENCE_FLOOR=0.55

# How many transcript lines of lecture context to attach to an answer.
COURSEMATE_TRANSCRIPT_WINDOW=40

# ── Push (APNs) ───────────────────────────────────────────────────────────────
# Off unless all of COURSEMATE_PUSH, APNS_KEY_PATH, APNS_KEY_ID and APNS_TEAM_ID
# are set: a provider that cannot sign a token should not claim to be enabled.
# COURSEMATE_PUSH=1
# APNS_KEY_PATH=secrets/AuthKey_ABC1234567.p8
# APNS_KEY_ID=ABC1234567
# APNS_TEAM_ID=DEF7654321
# APNS_TOPIC=us.innotel.coursemate
# APNS_ENVIRONMENT=sandbox          # sandbox | production
# COURSEMATE_PUSH_MIN_CONFIDENCE=0.6

# Identity is Cerulean Authentik (OIDC); DNS, TLS and the public proxy are Cerulean.
# Production secrets live in Cerulean Vault (KV v2) and are resolved from vault://<mount>/<path>#<KEY> refs.
